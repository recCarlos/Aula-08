@{
    ViewData["Title"] = "Catálogo de Produtos";

    var produtos = ViewBag.Produtos as List<string>;
    var precos = ViewBag.Precos as List<double>;
}

<h1>Catálogo de Produtos</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Produto</th>
            <th>Preço</th>
        </tr>
    </thead>

    <tbody>
        @for (int i = 0; i < produtos.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@produtos[i]</td>

                @if (precos[i] < 100)
                {
                    <td style="color:green">
                        R$ @precos[i]
                    </td>
                }
                else
                {
                    <td>
                        R$ @precos[i]
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<h3>Total: @produtos.Count produtos</h3>